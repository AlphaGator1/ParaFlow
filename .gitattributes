# Normalise to LF in the repository and check out native on Windows. Without
# this every commit from a Windows working tree warns about CRLF conversion,
# and a contributor on another platform sees the whole file as changed.
* text=auto

# Windows-only tooling that genuinely wants CRLF.
*.ps1   text eol=crlf
*.nsh   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Never touched by the text filters.
*.png   binary
*.ico   binary
*.gguf  binary
*.bin   binary
*.wav   binary
*.exe   binary
*.zip   binary
